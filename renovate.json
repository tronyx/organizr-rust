{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": ["develop"],
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "7 days",
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "The base image of the runtime. A new digest of the same tag carries the security fixes of Debian, so it comes at once.",
      "matchDepNames": ["gcr.io/distroless/cc-debian13"],
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAge": "0 days",
      "groupName": "Runtime image"
    },
    {
      "description": "The Rust version is in rust-toolchain.toml and in the image of the build. The build fails when they differ, so both change in one pull request.",
      "matchDepNames": ["rust", "rust-lang/rust"],
      "groupName": "Rust toolchain"
    },
    {
      "description": "Small updates of the Rust libraries come as one pull request.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust libraries"
    },
    {
      "description": "Small updates of the libraries of the web interface come as one pull request.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Web libraries"
    },
    {
      "description": "The actions and the tools of the workflows come as one pull request.",
      "matchManagers": ["github-actions", "custom.regex"],
      "matchFileNames": [".github/workflows/**"],
      "groupName": "Workflow tools"
    },
    {
      "description": "The image of the PHP application is the reference for the parity tests. Its version stays.",
      "matchFileNames": ["parity/**"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Rust version of rust-toolchain.toml.",
      "managerFilePatterns": ["/^rust-toolchain\\.toml$/"],
      "matchStrings": ["channel = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "The images of the tools that a workflow runs with docker run, with their digests.",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "\\s(?<depName>hadolint/hadolint|rhysd/actionlint|ghcr\\.io/aquasecurity/trivy):(?<currentValue>v?\\d+\\.\\d+\\.\\d+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The BuildKit image of the image build, with its digest.",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "image=(?<depName>moby/buildkit):(?<currentValue>v\\d+\\.\\d+\\.\\d+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The Buildx version of the image build.",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "uses: docker/setup-buildx-action@[^\\n]+\\n\\s+with:\\n\\s+version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "docker/buildx",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "The Node.js version of the CI job for the web interface.",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": ["node-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    }
  ]
}
