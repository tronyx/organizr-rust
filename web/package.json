    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.70.0",
    "bits-ui": "2.20.6",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0"
  }
